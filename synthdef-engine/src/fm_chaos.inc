static void chaos_FBSineL_next(chaos_unit* unit, int inNumSamples) {
    float* out = unit->out;
    float freq = unit->args[0];
    float a = unit->args[1];
    float b = unit->args[2];
    float c = unit->args[3];
    float d = unit->args[4];
    float x0 = unit->args[5];
    float y0 = unit->args[6];

    float xn = unit->s->xn;
    float yn = unit->s->yn;
    float xnm1 = unit->s->xnm1;
    float counter = unit->s->counter;
    float frac = unit->s->frac;

    float samplesPerCycle;
    float slope;
    if (freq < unit->sr) {
        samplesPerCycle = unit->sr / fmaxf(freq, 0.001f);
        slope = 1.f / samplesPerCycle;
    } else {
        samplesPerCycle = 1.f;
        slope = 1.f;
    }

    if ((unit->s->x0 != x0) || (unit->s->y0 != y0)) {
        xnm1 = xn;
        unit->s->x0 = xn = x0;
        unit->s->y0 = yn = y0;
    }

    float dx = xn - xnm1;

    for (int i = 0; i < inNumSamples; ++i) {
        if (counter >= samplesPerCycle) {
            counter -= samplesPerCycle;
            frac = 0.0f;
            xnm1 = xn;

            xn = sinf(a * yn + b * xn);
            yn = c * yn + d;
            yn = chaos_mod2pi(yn);

            dx = xn - xnm1;
        }
        counter++;
        *out++ = xnm1 + dx * frac;
        frac += slope;
    }
    unit->s->xn = xn;
    unit->s->yn = yn;
    unit->s->xnm1 = xnm1;
    unit->s->counter = counter;
    unit->s->frac = frac;
}

